# Edge router for the Railway deployment.
#
# Differences from the upstream nginx/nginx.conf:
#   - No TLS block. Railway terminates TLS at its edge and forwards plain HTTP,
#     so the original `listen 443 ssl` + certificate files would never load.
#   - The real client scheme arrives as X-Forwarded-Proto. Passing $scheme
#     through instead would tell GoTrue the site is http:// and break the
#     OAuth/magic-link redirects it builds.
#   - No /minio/ or /minio-api/ blocks: object storage is a Railway bucket
#     reached directly over the public S3 endpoint, not a service behind nginx.
#   - No /pgadmin/ block (service not deployed).
#   - Upstreams are variables so nginx boots even when a backend is still
#     starting; with a literal proxy_pass, one unresolvable name aborts startup
#     and the whole edge stays down.

events {
    worker_connections 1024;
}

http {
    # Resolved from the container's own /etc/resolv.conf at startup by
    # docker-entrypoint.sh — Railway's internal DNS address is not fixed.
    resolver ${RESOLVER} valid=10s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Railway's edge always sets X-Forwarded-Proto; $scheme is the fallback for
    # direct private-network calls.
    map $http_x_forwarded_proto $forwarded_scheme {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    server {
        listen ${PORT};
        listen [::]:${PORT};

        client_max_body_size 10M;
        underscores_in_headers on;

        set $cloud_backend  "http://${CLOUD_UPSTREAM}";
        set $gotrue_backend "http://${GOTRUE_UPSTREAM}";
        set $admin_backend  "http://${ADMIN_UPSTREAM}";
        set $web_backend    "http://${WEB_UPSTREAM}";

        location /gotrue/ {
            proxy_pass $gotrue_backend;
            rewrite ^/gotrue(/.*)$ $1 break;

            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;
            proxy_pass_request_headers on;
        }

        location /ws {
            proxy_pass $cloud_backend;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;
            proxy_read_timeout 86400s;
        }

        location /api {
            proxy_pass $cloud_backend;
            proxy_set_header X-Request-Id $request_id;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;

            location ~* ^/api/workspace/([a-zA-Z0-9_-]+)/publish$ {
                proxy_pass $cloud_backend;
                proxy_set_header Host $http_host;
                proxy_set_header X-Forwarded-Proto $forwarded_scheme;
                proxy_request_buffering off;
                client_max_body_size 256M;
            }

            location /api/chat {
                proxy_pass $cloud_backend;
                proxy_set_header Host $http_host;
                proxy_set_header X-Forwarded-Proto $forwarded_scheme;

                proxy_http_version 1.1;
                proxy_set_header Connection "";
                chunked_transfer_encoding on;
                proxy_buffering off;
                proxy_cache off;

                proxy_read_timeout 600s;
                proxy_connect_timeout 600s;
                proxy_send_timeout 600s;
            }

            location /api/import {
                proxy_pass $cloud_backend;

                proxy_set_header X-Request-Id $request_id;
                proxy_set_header Host $http_host;
                proxy_set_header X-Forwarded-Proto $forwarded_scheme;

                proxy_read_timeout 600s;
                proxy_connect_timeout 600s;
                proxy_send_timeout 600s;

                proxy_request_buffering off;
                proxy_buffering off;
                proxy_cache off;
                client_max_body_size 2G;
            }
        }

        location /ai/ {
            proxy_pass $cloud_backend;
            proxy_set_header X-Request-Id $request_id;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;
        }

        location /console {
            proxy_pass $admin_backend;

            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Scheme $forwarded_scheme;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_cache_bypass $http_upgrade;
        }

        location / {
            proxy_pass $web_backend;
            proxy_set_header X-Scheme $forwarded_scheme;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;
            proxy_set_header Host $host;
        }
    }
}
